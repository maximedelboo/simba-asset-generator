(*
# XTEA
Standard XTEA, 32 rounds, delta 0x9E3779B9, over big-endian 8-byte blocks.
Trailing bytes that do not fill a block are left as-is, matching the game client.
*)
{$DEFINE WL_CACHE_XTEA_INCLUDED}

procedure XTEADecrypt(var data: TByteArray; const key: TIntegerArray);
const
  GOLDEN_RATIO: UInt32 = $9E3779B9;
  ROUNDS: Integer = 32;
var
  blocks, block, i, o: Integer;
  v0, v1, sum: UInt32;
begin
  if Length(key) <> 4 then
    raise 'XTEA: key must be 4 ints, got ' + ToStr(Length(key));

  blocks := Length(data) div 8;
  for block := 0 to blocks - 1 do
  begin
    o := block * 8;
    v0 := (UInt32(data[o])   shl 24) or (UInt32(data[o+1]) shl 16) or (UInt32(data[o+2]) shl 8) or UInt32(data[o+3]);
    v1 := (UInt32(data[o+4]) shl 24) or (UInt32(data[o+5]) shl 16) or (UInt32(data[o+6]) shl 8) or UInt32(data[o+7]);

    sum := GOLDEN_RATIO * UInt32(ROUNDS);
    for i := 1 to ROUNDS do
    begin
      v1 -= (((v0 shl 4) xor (v0 shr 5)) + v0) xor (sum + UInt32(key[(sum shr 11) and 3]));
      sum -= GOLDEN_RATIO;
      v0 -= (((v1 shl 4) xor (v1 shr 5)) + v1) xor (sum + UInt32(key[sum and 3]));
    end;

    data[o]   := (v0 shr 24) and $FF;
    data[o+1] := (v0 shr 16) and $FF;
    data[o+2] := (v0 shr 8)  and $FF;
    data[o+3] := v0 and $FF;
    data[o+4] := (v1 shr 24) and $FF;
    data[o+5] := (v1 shr 16) and $FF;
    data[o+6] := (v1 shr 8)  and $FF;
    data[o+7] := v1 and $FF;
  end;
end;

procedure XTEAEncrypt(var data: TByteArray; const key: TIntegerArray);
const
  GOLDEN_RATIO: UInt32 = $9E3779B9;
  ROUNDS: Integer = 32;
var
  blocks, block, i, o: Integer;
  v0, v1, sum: UInt32;
begin
  if Length(key) <> 4 then
    raise 'XTEA: key must be 4 ints, got ' + ToStr(Length(key));

  blocks := Length(data) div 8;
  for block := 0 to blocks - 1 do
  begin
    o := block * 8;
    v0 := (UInt32(data[o])   shl 24) or (UInt32(data[o+1]) shl 16) or (UInt32(data[o+2]) shl 8) or UInt32(data[o+3]);
    v1 := (UInt32(data[o+4]) shl 24) or (UInt32(data[o+5]) shl 16) or (UInt32(data[o+6]) shl 8) or UInt32(data[o+7]);

    sum := 0;
    for i := 1 to ROUNDS do
    begin
      v0 += (((v1 shl 4) xor (v1 shr 5)) + v1) xor (sum + UInt32(key[sum and 3]));
      sum += GOLDEN_RATIO;
      v1 += (((v0 shl 4) xor (v0 shr 5)) + v0) xor (sum + UInt32(key[(sum shr 11) and 3]));
    end;

    data[o]   := (v0 shr 24) and $FF;
    data[o+1] := (v0 shr 16) and $FF;
    data[o+2] := (v0 shr 8)  and $FF;
    data[o+3] := v0 and $FF;
    data[o+4] := (v1 shr 24) and $FF;
    data[o+5] := (v1 shr 16) and $FF;
    data[o+6] := (v1 shr 8)  and $FF;
    data[o+7] := v1 and $FF;
  end;
end;
