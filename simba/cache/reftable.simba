(*
# CacheRefTable
Parses a reference table: the idx255 entry for index N describes index N's archives,
their file ids, CRCs and revisions. Protocol 5, 6 and 7 are supported; the live OSRS
cache uses 7 with the SIZED flag, where ids and counts are bigsmart-encoded.
*)
{$DEFINE WL_CACHE_REFTABLE_INCLUDED}
{$IFNDEF WL_CACHE_BYTESTREAM_INCLUDED}{$INCLUDE_ONCE bytestream.simba}{$ENDIF}

const
  REFTABLE_FLAG_NAMED: Integer = 1;
  REFTABLE_FLAG_SIZED: Integer = 4;

type
  TCacheArchiveInfo = record
    Id: Integer;
    NameHash: Integer;
    CRC: Integer;
    Revision: Integer;
    CompressedSize: Integer;
    DecompressedSize: Integer;
    FileIds: TIntegerArray;
    FileNameHashes: TIntegerArray;
  end;

  TCacheRefTable = record
    Protocol: Integer;
    Revision: Integer;
    Named: Boolean;
    Sized: Boolean;
    Archives: array of TCacheArchiveInfo;
  end;

function TCacheRefTable.Parse(data: TByteArray): TCacheRefTable; static;
var
  s: TByteStream;
  flags, count, i, j, last, num: Integer;
  counts: TIntegerArray;
begin
  // idx16 exists on disk but has no idx255 entry describing it, so TCacheStore.Read
  // hands back an empty array. Without this the first read raises the opaque
  // 'ByteStream: read past end at 0'.
  if Length(data) = 0 then
    raise 'CacheRefTable: empty reference table';

  s := TByteStream.Create(data);

  Result.Protocol := s.ReadUByte();
  if (Result.Protocol < 5) or (Result.Protocol > 7) then
    raise 'CacheRefTable: unsupported protocol ' + ToStr(Result.Protocol);

  if Result.Protocol >= 6 then
    Result.Revision := s.ReadInt();

  flags := s.ReadUByte();
  Result.Named := (flags and REFTABLE_FLAG_NAMED) <> 0;
  Result.Sized := (flags and REFTABLE_FLAG_SIZED) <> 0;
  if (flags and (not (REFTABLE_FLAG_NAMED or REFTABLE_FLAG_SIZED))) <> 0 then
    raise 'CacheRefTable: unknown flags ' + ToStr(flags);

  if Result.Protocol >= 7 then
    count := s.ReadBigSmart()
  else
    count := s.ReadUShort();

  SetLength(Result.Archives, count);

  last := 0;
  for i := 0 to count - 1 do
  begin
    if Result.Protocol >= 7 then
      last += s.ReadBigSmart()
    else
      last += s.ReadUShort();
    Result.Archives[i].Id := last;
  end;

  if Result.Named then
    for i := 0 to count - 1 do
      Result.Archives[i].NameHash := s.ReadInt();

  for i := 0 to count - 1 do
    Result.Archives[i].CRC := s.ReadInt();

  if Result.Sized then
    for i := 0 to count - 1 do
    begin
      Result.Archives[i].CompressedSize := s.ReadInt();
      Result.Archives[i].DecompressedSize := s.ReadInt();
    end;

  for i := 0 to count - 1 do
    Result.Archives[i].Revision := s.ReadInt();

  SetLength(counts, count);
  for i := 0 to count - 1 do
    if Result.Protocol >= 7 then
      counts[i] := s.ReadBigSmart()
    else
      counts[i] := s.ReadUShort();

  for i := 0 to count - 1 do
  begin
    num := counts[i];
    SetLength(Result.Archives[i].FileIds, num);
    last := 0;
    for j := 0 to num - 1 do
    begin
      if Result.Protocol >= 7 then
        last += s.ReadBigSmart()
      else
        last += s.ReadUShort();
      Result.Archives[i].FileIds[j] := last;
    end;
  end;

  if Result.Named then
    for i := 0 to count - 1 do
    begin
      num := counts[i];
      SetLength(Result.Archives[i].FileNameHashes, num);
      for j := 0 to num - 1 do
        Result.Archives[i].FileNameHashes[j] := s.ReadInt();
    end;
end;

function TCacheRefTable.IndexOfArchive(id: Integer): Integer;
begin
  for Result := 0 to High(Self.Archives) do
    if Self.Archives[Result].Id = id then
      Exit;
  Result := -1;
end;

(*
## SplitArchiveFiles
```pascal
function SplitArchiveFiles(data: TByteArray; fileCount: Integer): array of TByteArray;
```
Splits a decompressed archive into its files. Single-file archives are returned as-is.
Multi-file archives end with `chunks * fileCount` big-endian int32 size deltas followed
by a single byte holding the chunk count.
*)
function SplitArchiveFiles(data: TByteArray; fileCount: Integer): array of TByteArray;
var
  s: TByteStream;
  chunks, chunk, id, delta, size, pos, i: Integer;
  chunkSizes: array of TIntegerArray;
  sizes, offsets: TIntegerArray;
begin
  if fileCount <= 1 then
    Exit([data]);

  s := TByteStream.Create(data);
  s.Position := s.Length() - 1;
  chunks := s.ReadUByte();
  if chunks < 1 then
    raise 'SplitArchiveFiles: chunk count is ' + ToStr(chunks);

  SetLength(chunkSizes, fileCount);
  for i := 0 to fileCount - 1 do
    SetLength(chunkSizes[i], chunks);
  SetLength(sizes, fileCount);
  SetLength(offsets, fileCount);

  s.Position := s.Length() - 1 - chunks * fileCount * 4;
  if s.Position < 0 then
    raise 'SplitArchiveFiles: chunk table does not fit in the archive';

  for chunk := 0 to chunks - 1 do
  begin
    size := 0;
    for id := 0 to fileCount - 1 do
    begin
      delta := s.ReadInt();
      size += delta;
      chunkSizes[id][chunk] := size;
      sizes[id] += size;
    end;
  end;

  SetLength(Result, fileCount);
  for i := 0 to fileCount - 1 do
    SetLength(Result[i], sizes[i]);

  s.Position := 0;
  for chunk := 0 to chunks - 1 do
    for id := 0 to fileCount - 1 do
    begin
      size := chunkSizes[id][chunk];
      pos := offsets[id];
      for i := 0 to size - 1 do
        Result[id][pos + i] := s.ReadUByte();
      offsets[id] += size;
    end;
end;
