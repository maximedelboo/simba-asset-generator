(*
## TCacheDefs.Underlay
```pascal
function TCacheDefs.Underlay(id: Integer): TUnderlayDefinition;
```
Underlay definition `id`, or a zeroed definition with `Id = -1`.

Map tiles store an underlay as "id + 1", 0 meaning none - subtract one before
calling, exactly as the Java map dumper's `findUnderlay(underlayId - 1)` does.
*)
function TCacheDefs.Underlay(id: Integer): TUnderlayDefinition;
var
  data: TByteArray;
begin
  if not Self.ConfigFile(Ord(EConfigType.UNDERLAY), id, data) then
  begin
    Result.Id := -1;  // the rest of Result is already zeroed
    Exit;
  end;
  Result := TUnderlayDefinition.Load(id, data);
end;

(*
## TCacheDefs.Overlay
```pascal
function TCacheDefs.Overlay(id: Integer): TOverlayDefinition;
```
Overlay definition `id`, or a zeroed definition with `Id = -1`. Tiles store
overlay ids the same "id + 1" way underlays are stored.
*)
function TCacheDefs.Overlay(id: Integer): TOverlayDefinition;
var
  data: TByteArray;
begin
  if not Self.ConfigFile(Ord(EConfigType.OVERLAY), id, data) then
  begin
    Result.Id := -1;
    Exit;
  end;
  Result := TOverlayDefinition.Load(id, data);
end;

// Decodes index 9 archive 0 once. The ids come from the reference table walked
// by position alongside the files - one pass, no per-file lookup.
procedure TCacheDefs.LoadTextures();
var
  table: TCacheRefTable;
  files: array of TByteArray;
  ids: TIntegerArray;
  a, i: Integer;
begin
  if Self.TexLoaded then Exit;
  Self.TexLoaded := True;
  Self.TexDefs := [];

  files := Self.Store.ReadFiles(Ord(EIndexType.TEXTURES), 0, []);
  if Length(files) = 0 then Exit;

  table := Self.Store.GetRefTable(Ord(EIndexType.TEXTURES));
  a := table.IndexOfArchive(0);
  if a = -1 then Exit;
  ids := table.Archives[a].FileIds;

  SetLength(Self.TexDefs, Length(files));
  for i := 0 to High(files) do
    Self.TexDefs[i] := TTextureDefinition.Load(ids[i], files[i]);
end;

(*
## TCacheDefs.Textures
```pascal
function TCacheDefs.Textures(): array of TTextureDefinition;
```
Every texture definition, in file order - which is what `TModelDefinition.Colors`
wants. **Position is not id**: the live cache has no texture 54, so position 54
holds id 55 and everything after it is offset by one. Use `Texture(id)` to look
one up.

The array and its `FileIds` are copies; writing to them does not reach the cache.
*)
function TCacheDefs.Textures(): array of TTextureDefinition;
var
  i: Integer;
begin
  Self.LoadTextures();

  // A record assignment copies the scalars but shares the dynamic arrays, so
  // FileIds has to be copied explicitly or the caller holds a live handle on
  // the cache. 208 textures - the copy does not show up in a profile.
  SetLength(Result, Length(Self.TexDefs));
  for i := 0 to High(Result) do
  begin
    Result[i] := Self.TexDefs[i];
    Result[i].FileIds := Copy(Self.TexDefs[i].FileIds);
  end;
end;

(*
## TCacheDefs.Texture
```pascal
function TCacheDefs.Texture(id: Integer): TTextureDefinition;
```
The texture definition whose `Id` is `id`, or a zeroed definition with `Id = -1`
if there is none (id 54 is such a hole in the live cache).

This searches by id rather than indexing by position on purpose: 84 models take
a wrong face colour when the table is indexed positionally, and nothing about
the result looks wrong enough to notice.
*)
function TCacheDefs.Texture(id: Integer): TTextureDefinition;
var
  i: Integer;
begin
  Self.LoadTextures();

  // Positional fast path first, then a scan; the guess is verified against the
  // stored Id, so it can never answer for the wrong texture.
  if (id >= 0) and (id <= High(Self.TexDefs)) and (Self.TexDefs[id].Id = id) then
    i := id
  else
  begin
    for i := 0 to High(Self.TexDefs) do
      if Self.TexDefs[i].Id = id then Break;
    // A loop that ran to the end leaves i past High; one that never ran leaves
    // it at 0 with High at -1. Both are caught before TexDefs[i] is touched.
    if (i > High(Self.TexDefs)) or (Self.TexDefs[i].Id <> id) then
    begin
      Result.Id := -1;
      Exit;
    end;
  end;

  Result := Self.TexDefs[i];
  Result.FileIds := Copy(Self.TexDefs[i].FileIds);
end;

(*
## TCacheDefs.Model
```pascal
function TCacheDefs.Model(id: Integer): TModelDefinition;
```
Model `id`. Index 7 holds one model per archive, so this is a read and a decode
with no archive split and nothing worth caching - the caller decides which
models are worth keeping.

An id outside index 7 gives a cleared definition with `Id = -1`; a model that is
present but does not decode raises.
*)
function TCacheDefs.Model(id: Integer): TModelDefinition;
var
  data: TByteArray;
begin
  if (id < 0) or (id >= Self.Store.ArchiveCount(Ord(EIndexType.MODELS))) then
  begin
    Result.Reset(-1);
    Exit;
  end;

  data := Self.Store.Read(Ord(EIndexType.MODELS), id, []);
  if Length(data) = 0 then
  begin
    Result.Reset(-1);
    Exit;
  end;

  Result := TModelDefinition.Load(id, data);
end;

(*
## TCacheDefs.Sprites
```pascal
function TCacheDefs.Sprites(archive: Integer): array of TSpriteDefinition;
```
Every frame of sprite archive `archive`. Sprites come in archives, not files:
one archive is one sprite and holds one frame per animation step, so this
returns an array where the other lookups return a record.

An unallocated archive - index 8 has plenty - gives an empty array.
*)
function TCacheDefs.Sprites(archive: Integer): array of TSpriteDefinition;
var
  data: TByteArray;
begin
  if (archive < 0) or (archive >= Self.Store.ArchiveCount(Ord(EIndexType.SPRITES))) then
    Exit([]);

  data := Self.Store.Read(Ord(EIndexType.SPRITES), archive, []);
  if Length(data) = 0 then Exit([]);

  Result := TSpriteDefinition.LoadAll(archive, data);
end;

(*
## TCacheDefs.Region
```pascal
function TCacheDefs.Region(x, y: Integer): TRegion;
```
The region at region coordinates `x, y` - i.e. world coordinates shifted right
by 6. A region that is not in the cache comes back with `HasTerrain = False`.

No XTEA keys are passed. A live client cache does not need them (see
`dev/tests/290_region.simba`, which loads all 2870 regions with none); call
`TRegion.Load` directly if you ever work off a dump that does.
*)
function TCacheDefs.Region(x, y: Integer): TRegion;
begin
  Result := TRegion.Load(Self.Store, RegionIdOf(x, y), []);
end;

(*
## TCacheDefs.ItemCount
```pascal
function TCacheDefs.ItemCount(): Integer;
```
How many item definitions the cache holds. This is a *file count*, not
`max id + 1`: the archive has gaps, so the highest item id is larger than this.
*)
function TCacheDefs.ItemCount(): Integer;
begin
  Result := Self.ConfigCount(Ord(EConfigType.ITEM));
end;

(*
## TCacheDefs.ObjCount
```pascal
function TCacheDefs.ObjCount(): Integer;
```
How many object definitions the cache holds. A file count, see `ItemCount`.
*)
function TCacheDefs.ObjCount(): Integer;
begin
  Result := Self.ConfigCount(Ord(EConfigType.OBJECTS));
end;

(*
## TCacheDefs.NpcCount
```pascal
function TCacheDefs.NpcCount(): Integer;
```
How many NPC definitions the cache holds. The NPC archive happens to have no
gaps today, so this also equals `max id + 1` - do not rely on that.
*)
function TCacheDefs.NpcCount(): Integer;
begin
  Result := Self.ConfigCount(Ord(EConfigType.NPC));
end;
