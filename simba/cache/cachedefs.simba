(*
# CacheDefs
One handle on a cache directory that answers "give me definition `id`", so a
dumper does not have to know which index a thing lives in, which archive inside
it, or that file ids are not array positions.

```pascal
var defs: TCacheDefs;
defs := TCacheDefs.Create(GetEnvVar('HOME') + '/.runelite/jagexcache/oldschool/LIVE');
WriteLn(defs.Item(4151).Name);   // Abyssal whip
```

## What lives where
| method | index | archive |
|---|---|---|
| `Item`/`Obj`/`Npc`/`Underlay`/`Overlay` | 2 CONFIGS | the `EConfigType` archive, split into files |
| `Texture`/`Textures` | 9 TEXTURES | archive 0, split into files |
| `Model` | 7 MODELS | one archive per model, one file |
| `Sprites` | 8 SPRITES | one archive per sprite, many frames |
| `Region` | 5 MAPS | one archive per region |

## Caching
The config archives and the texture archive are read, decompressed and split on
the first lookup that needs them, then kept. That first read is not cheap - the
ITEM archive is 2.6 MB of bzip2 - and a dumper asks for tens of thousands of
definitions, so it has to be paid once. Each archive gets its own slot, so
asking for an object does not evict the items.

Only the *bytes* are cached, not the decoded records: every call decodes fresh,
which costs microseconds and means a returned definition can never be a window
into the cache. Textures are the one exception - they are decoded once because
`Model.Colors` needs the whole table - and `Textures`/`Texture` therefore hand
out copies, `FileIds` included. Mutate what you get back freely.

`TCacheDefs` is a plain record and `Store` is a plain field, so the cache lives
on whichever variable holds it: copy the record and the copy starts cold, same
as `TCacheStore`. Pass it as `var` rather than by value.

## Do not use this to walk a whole archive
Every by-id lookup maps the id to a file position through `FilePositionOf`,
which is a scan. Calling it 33372 times to read every item is quadratic. To
iterate, walk the reference table and the file array together by position -
`FileIds[i]` is the id of file `i`:

```pascal
table := defs.Store.GetRefTable(Ord(EIndexType.CONFIGS));
a := table.IndexOfArchive(Ord(EConfigType.ITEM));
files := defs.Store.ReadFiles(Ord(EIndexType.CONFIGS), Ord(EConfigType.ITEM), []);
for i := 0 to High(files) do
  item := TItemDefinition.Load(table.Archives[a].FileIds[i], files[i]);
```

## Misses
An id the cache does not hold gives back a default definition with `Id = -1`
(`HasTerrain = False` for a region, an empty array for sprites) rather than
raising: id spaces are sparse and a caller sweeping a range should not have to
know where the holes are. A malformed *present* archive still raises from the
loader underneath - that is a bug, not a gap.
*)
{$DEFINE WL_CACHE_DEFS_INCLUDED}
{$IFNDEF WL_CACHE_TYPES_INCLUDED}{$INCLUDE_ONCE cachetypes.simba}{$ENDIF}
{$IFNDEF WL_CACHE_STORE_INCLUDED}{$INCLUDE_ONCE store.simba}{$ENDIF}
{$IFNDEF WL_CACHE_REGION_INCLUDED}{$INCLUDE_ONCE region.simba}{$ENDIF}
{$IFNDEF WL_CACHE_DEF_ITEM_INCLUDED}{$INCLUDE_ONCE defs/item.simba}{$ENDIF}
{$IFNDEF WL_CACHE_DEF_OBJECT_INCLUDED}{$INCLUDE_ONCE defs/object.simba}{$ENDIF}
{$IFNDEF WL_CACHE_DEF_NPC_INCLUDED}{$INCLUDE_ONCE defs/npc.simba}{$ENDIF}
{$IFNDEF WL_CACHE_DEF_TERRAIN_INCLUDED}{$INCLUDE_ONCE defs/terrain.simba}{$ENDIF}
{$IFNDEF WL_CACHE_DEF_SPRITE_INCLUDED}{$INCLUDE_ONCE defs/sprite.simba}{$ENDIF}
{$IFNDEF WL_CACHE_DEF_MODEL_INCLUDED}{$INCLUDE_ONCE defs/model.simba}{$ENDIF}

type
  // One split archive. This wrapper exists only because the cache is a list of
  // file arrays and `array of array of TByteArray` is a shape worth avoiding.
  TCacheFileSet = record
    Files: array of TByteArray;
  end;

  TCacheDefs = record
    Store: TCacheStore;

    // Per-config-archive file cache, two parallel arrays scanned linearly:
    // there are 21 config archives at most and only a handful are ever asked
    // for, so a scan beats a map. See TCacheDefs.CacheSlot.
    CfgIds: TIntegerArray;
    CfgFiles: array of TCacheFileSet;

    TexLoaded: Boolean;
    TexDefs: array of TTextureDefinition;
  end;

(*
## TCacheDefs.Create
```pascal
function TCacheDefs.Create(directory: String): TCacheDefs; static;
```
Opens the cache in `directory` - the folder holding `main_file_cache.dat2`,
e.g. `~/.runelite/jagexcache/oldschool/LIVE`. Raises if there is none.
Reads nothing yet; the first lookup does that.
*)
function TCacheDefs.Create(directory: String): TCacheDefs; static;
begin
  Result.Store := TCacheStore.Create(directory);
end;

// Index of cfg's slot in CfgIds/CfgFiles, reading and splitting the archive on
// the first call for it. Self is by reference, so the split survives the call.
function TCacheDefs.CacheSlot(cfg: Integer): Integer;
var
  i: Integer;
begin
  for i := 0 to High(Self.CfgIds) do
    if Self.CfgIds[i] = cfg then Exit(i);

  SetLength(Self.CfgIds, Length(Self.CfgIds) + 1);
  SetLength(Self.CfgFiles, Length(Self.CfgFiles) + 1);
  Result := High(Self.CfgIds);
  Self.CfgIds[Result] := cfg;
  Self.CfgFiles[Result].Files := Self.Store.ReadFiles(Ord(EIndexType.CONFIGS), cfg, []);
end;

(*
## TCacheDefs.ConfigFile
```pascal
function TCacheDefs.ConfigFile(cfg, id: Integer; var data: TByteArray): Boolean;
```
The one file holding definition `id` in config archive `cfg`, or False if the
archive has no such id. `data` aliases the cached bytes rather than copying
them - the loaders only read it.

The id is resolved through the reference table *before* the archive is touched,
so a miss on a cold `TCacheDefs` costs a table lookup instead of a 2.6 MB bzip2
decompress.
*)
function TCacheDefs.ConfigFile(cfg, id: Integer; var data: TByteArray): Boolean;
var
  slot, pos: Integer;
begin
  data := [];
  if id < 0 then Exit(False);

  // Never `Files[id]`: file ids have gaps, so from the first one on, the id and
  // the array position are different numbers. See FilePositionOf.
  pos := FilePositionOf(Self.Store.GetRefTable(Ord(EIndexType.CONFIGS)), cfg, id);
  if pos = -1 then Exit(False);

  slot := Self.CacheSlot(cfg);
  if pos > High(Self.CfgFiles[slot].Files) then Exit(False);

  data := Self.CfgFiles[slot].Files[pos];
  Result := True;
end;

// How many definitions config archive cfg holds. Answered from the reference
// table, so it does not pull the archive itself in.
function TCacheDefs.ConfigCount(cfg: Integer): Integer;
var
  table: TCacheRefTable;
  a: Integer;
begin
  table := Self.Store.GetRefTable(Ord(EIndexType.CONFIGS));
  a := table.IndexOfArchive(cfg);
  if a = -1 then Exit(0);
  Result := Length(table.Archives[a].FileIds);
end;

(*
## TCacheDefs.Item
```pascal
function TCacheDefs.Item(id: Integer): TItemDefinition;
```
Item definition `id`, or `TItemDefinition.Default(-1)` if the cache has no such
item.
*)
function TCacheDefs.Item(id: Integer): TItemDefinition;
var
  data: TByteArray;
begin
  if not Self.ConfigFile(Ord(EConfigType.ITEM), id, data) then
  begin
    Result := TItemDefinition.Default(-1);
    Exit;
  end;
  Result := TItemDefinition.Load(id, data);
end;

(*
## TCacheDefs.Obj
```pascal
function TCacheDefs.Obj(id: Integer): TObjectDefinition;
```
Object definition `id`, or `TObjectDefinition.Default(-1)` if there is none.
Named `Obj` because `Object` is a reserved word in Lape.
*)
function TCacheDefs.Obj(id: Integer): TObjectDefinition;
var
  data: TByteArray;
begin
  if not Self.ConfigFile(Ord(EConfigType.OBJECTS), id, data) then
  begin
    Result := TObjectDefinition.Default(-1);
    Exit;
  end;
  Result := TObjectDefinition.Load(id, data);
end;

(*
## TCacheDefs.Npc
```pascal
function TCacheDefs.Npc(id: Integer): TNpcDefinition;
```
NPC definition `id`, or `TNpcDefinition.Default(-1)` if there is none.
