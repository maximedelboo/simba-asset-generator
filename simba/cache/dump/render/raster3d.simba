// TextureProvider's tiny item-sprite surface. Texture decoding lives with the
// cache-backed source in itemsprite.simba; this unit owns the state consumed by
// the generated triangle routine so it has no dependency on cache I/O.
var
  texturePixels: array of TIntegerArray;
  textureAverageRGB: TIntegerArray;
  textureIsOpaque: array of Boolean;
  texturePresent: array of Boolean;
  lowMem: Boolean = False;
  field1909: Boolean = False;

procedure TextureProviderClear(maxId: Integer);
begin
  texturePixels := [];
  textureAverageRGB := [];
  textureIsOpaque := [];
  texturePresent := [];
  if maxId < 0 then Exit;
  SetLength(texturePixels, maxId + 1);
  SetLength(textureAverageRGB, maxId + 1);
  SetLength(textureIsOpaque, maxId + 1);
  SetLength(texturePresent, maxId + 1);
end;

procedure TextureProviderPut(id: Integer; pixels: TIntegerArray; averageRGB: Integer; opaque: Boolean);
begin
  if (id < 0) or (id > High(texturePresent)) then Exit;
  texturePixels[id] := pixels;
  textureAverageRGB[id] := averageRGB;
  textureIsOpaque[id] := opaque;
  texturePresent[id] := True;
end;

function TextureLoad(id: Integer): TIntegerArray;
begin
  if (id < 0) or (id > High(texturePresent)) or not texturePresent[id] then Exit;
  Result := texturePixels[id];
end;

function TextureAverage(id: Integer): Integer;
begin
  if (id < 0) or (id > High(texturePresent)) then Exit(0);
  Result := textureAverageRGB[id];
end;

function TextureOpaque(id: Integer): Boolean;
begin
  if (id < 0) or (id > High(texturePresent)) then Exit(False);
  Result := textureIsOpaque[id];
end;

function TextureLowDetail(id: Integer): Boolean;
begin
  // ItemSpriteFactory's RSTextureProvider fixes width to 128.
  Result := False;
end;

