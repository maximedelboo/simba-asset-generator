program ProfileMapShard;

(**
# Profile Map Shard

Read-only benchmark for one consecutive map-image shard. It is deliberately
separate from `generator.simba`: no asset, bundle or manifest is written, so a
profiling iteration takes one representative shard rather than a full mapdata
dump.

```text
Simba --root=/path/to/asset-generator --cache=/path/to/cache \
  --shard=0 --run tests/profile_map_shard.simba
```

`--shard` is zero-based and defaults to 0. Compare the same shard before and
after a change; use a second, geographically separate shard before extrapolating
to the whole map family.
*)
{$INCLUDE_ONCE ../simba/cache/dump/map/mapdata.simba}

var
  cacheDir, shardArg, savePath: String;
  store: TCacheStore;
  ids: TIntegerArray;
  mi: TMapImage;
  bundle: TMapBundle;
  t: Double;
  shard, first, last, shardCount: Integer;
begin
  cacheDir := Trim(GetProcessArg('cache'));
  if cacheDir = '' then
    raise 'ProfileMapShard: pass --cache=/path/to/unpacked/cache';
  if GetProcessArg('shard') then shardArg := Trim(GetProcessArg('shard'));
  if GetProcessArg('save') then savePath := Trim(GetProcessArg('save'));
  if shardArg = '' then shard := 0 else shard := StrToInt(shardArg);

  store := TCacheStore.Create(cacheDir);
  ids := MapDataRegionIds(store);
  shardCount := (Length(ids) + MAPDATA_REGIONS_PER_SHARD - 1) div
                MAPDATA_REGIONS_PER_SHARD;
  if (shard < 0) or (shard >= shardCount) then
    raise 'ProfileMapShard: shard must be 0..' + ToStr(shardCount - 1);

  first := shard * MAPDATA_REGIONS_PER_SHARD;
  last := Min(Length(ids), first + MAPDATA_REGIONS_PER_SHARD);
  mi := TMapImage.Create(store);
  t := PerformanceTime();
  bundle := MapDataImageShard(mi, ids, first, last);

  WriteLn('ProfileMapShard: shard ', shard, ' regions ', first + 1, '-', last,
          ' rendered ', Length(bundle.Names), ' chunks in ',
          Round(PerformanceTime() - t), ' ms');
  WriteLn('ProfileMapShard: neighbourhood ', Round(mi.ProfileNeighbourMS),
          ' ms (', mi.ProfileRegionLoads, ' cache misses; decode ',
          Round(mi.ProfileRegionDecodeMS), ' ms, project ',
          Round(mi.ProfileRegionProjectMS), ' ms)');
  WriteLn('ProfileMapShard: terrain ', Round(mi.ProfileTerrainMS),
          ' ms (plane build ', Round(mi.ProfilePlaneBuildMS), ' ms, composite ',
          Round(mi.ProfileTerrainMS - mi.ProfilePlaneBuildMS), ' ms), objects ',
          Round(mi.ProfileObjectsMS), ' ms, icons ', Round(mi.ProfileIconsMS), ' ms');
  if savePath <> '' then
  begin
    bundle.Save(savePath);
    WriteLn('ProfileMapShard: bundle saved to ', savePath);
  end;
  bundle.Init();
end.
